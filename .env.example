# Copy to .env and fill in. Never commit .env.
# The app loads .env on first use; values already set in the environment win.
BINARYREPAIR_ASSISTANT_PROVIDER_KEY=sk-your-key-here
BINARYREPAIR_ASSISTANT_PROVIDER_BASE_URL=https://api.deepseek.com/v1
BINARYREPAIR_ASSISTANT_MODEL=deepseek-chat
BINARYREPAIR_ASSISTANT_PROVIDER_TIMEOUT=120

# Legacy aliases are still accepted when the BINARYREPAIR_* names are unset:
#   DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL / DEEPSEEK_TIMEOUT_S

# "disabled" is cheaper and deterministic for structured output.
# "enabled" lets the model reason first; use it only for hard edits, and measure.
DEEPSEEK_THINKING=disabled

DEEPSEEK_TIMEOUT_S=120
DEEPSEEK_MAX_RETRIES=1
DEEPSEEK_MAX_OUTPUT_TOKENS=4000

BINARYREPAIR_AI_BUDGET_USD=2.0
BINARYREPAIR_MODEL_LOG=var/model_calls.jsonl
BINARYREPAIR_STORE_RAW=0

# Optional read-only binary vulnerability dataset roots
BINARYREPAIR_BINPOOL_ROOT=
BINARYREPAIR_CVEBINARYSHEET_ROOT=
BINARYREPAIR_CGC_ROOT=
