# Keep source, docs, manifests, and fixtures byte-stable across platforms.
* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.sql  text eol=lf
*.sh   text eol=lf
*.c    text eol=lf
*.h    text eol=lf
*.java text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

*.ps1  text eol=crlf
*.bat  text eol=crlf

# Fixture manifests are hashed as bytes; never let Git rewrite them.
fixtures/public/**/tests/*.json -text

# This case is pinned to SARD's shipped bytes, CRLF included. A text
# filter would change its sha256 and void defect.json#source.sha256.
fixtures/public/CWE122_c_CWE129_fgets_01/** -text
# The no-input case is hash-pinned to SARD's CRLF bytes by tests/SHA256SUMS;
# a text filter would turn original.c into 262dee1d... and void that file.
fixtures/public/CWE416_Use_After_Free__malloc_free_char_01_noinput/** -text

*.elf  binary
*.bin  binary
*.zip  binary
# Evidence packages are hash-bound: every byte (including CRLF) must survive
# clone/checkout exactly, or SHA256SUMS verification fails on a fresh clone.
docs/handoffs/evidence/** -text
*.pdf binary
*.vmdk binary
*.png binary
*.jpg binary
