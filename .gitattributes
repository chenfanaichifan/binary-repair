# Keep source, docs, manifests, and fixtures byte-stable across platforms.
* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.sql  text eol=lf
*.sh   text eol=lf
*.c    text eol=lf
*.h    text eol=lf
*.java text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

*.ps1  text eol=crlf
*.bat  text eol=crlf

# Fixture manifests are hashed as bytes; never let Git rewrite them.
fixtures/public/**/tests/*.json -text

*.elf  binary
*.bin  binary
*.zip  binary

# A digest manifest is read by `sha256sum -c`, which treats the rest of the line
# as a filename. With core.autocrlf=true, text=auto rewrites its trailing LF to
# CRLF and the checker then looks for a file whose name ends in a carriage
# return. Reproduced on dist/m5-delivery-2026-10-22.zip.sha256 before this rule.
*.sha256     -text
*.sha256sum  -text
# Evidence packages are hash-bound: every byte (including CRLF) must survive
# clone/checkout exactly, or SHA256SUMS verification fails on a fresh clone.
docs/handoffs/evidence/** -text
# Same reason: the M4 handoff is verified with `sha256sum -c SHA256SUMS`, so its
# files must arrive byte-identical on every platform - including the scripts and
# the expected-output JSON.
M4-v4-handoff-2026-11-06/** -text
T8.3-evidence-2026-11-06/** -text
*.pdf binary
*.vmdk binary
*.png binary
*.jpg binary

# A fixture is verified by hashing its files, so nothing under fixtures/public
# may be rewritten on checkout - not even a text file. This also keeps
# tests/SHA256SUMS byte-identical to what the intake hashed.
fixtures/public/** -text
