# Repository default: text files are LF in the index and in checkouts.
* text=auto eol=lf

# Binary artifacts must never be converted.
*.pdf binary
*.zip binary
*.elf binary
*.vmdk binary
*.png binary
*.jpg binary

# Evidence packages are hash-bound: every byte (including CRLF) must survive
# clone/checkout exactly, or SHA256SUMS verification fails on a fresh clone.
docs/handoffs/evidence/** -text
