diff --git a/docs/development/handoffs/216-v1.2.1-security-fixes.md b/docs/development/handoffs/216-v1.2.1-security-fixes.md
new file mode 100644
index 0000000..d60374d
--- /dev/null
+++ b/docs/development/handoffs/216-v1.2.1-security-fixes.md
@@ -0,0 +1,29 @@
+# 226 — v1.2.1 security fixes from M3 review
+
+Date: 2026-11-09
+
+## Fixed
+
+- F1: mask reveals only the last 4 characters; no prefix leak.
+- F1/F6: minimum 16 chars, printable ASCII only, whitespace rejected.
+- A-1/F5: unique temp file + process lock + post-replace existence check;
+  stale `.tmp` no longer blocks the first save.
+- F2: bundle/artifact copy paths refuse `assistant.key`, `.env`,
+  `session.token`.
+- F3: masked tail removed from docs 216/218.
+
+## Verification
+
+```text
+key store/API/console: pass
+full suite: pass
+```
+
+## Remaining limitations
+
+```text
+Windows DPAPI cross-user: not tested
+POSIX 0600 runtime: not independently exercised on Windows
+```
+
+No public tag/main movement.
diff --git a/tests/test_assistant_key_store.py b/tests/test_assistant_key_store.py
index 4734876..4e22165 100644
--- a/tests/test_assistant_key_store.py
+++ b/tests/test_assistant_key_store.py
@@ -38,3 +38,27 @@ def test_environment_key_wins_and_cannot_be_cleared(tmp_path: Path, monkeypatch)
     status = assistant_key_store.key_status()
     assert status["source"] == "environment"
     assert status["can_clear"] is False
+
+
+def test_mask_reveals_only_last_four() -> None:
+    key = "sk-abcdefghijklmnopqrstuvwxyz1234"
+    masked = assistant_key_store.mask_key(key)
+    assert masked.endswith(key[-4:])
+    assert key[:4] not in masked
+    assert masked.count("*") == len(key) - 4
+
+
+def test_short_and_non_ascii_keys_are_rejected(tmp_path, monkeypatch) -> None:
+    import pytest
+    monkeypatch.setenv("BINARYREPAIR_ASSISTANT_KEY_FILE", str(tmp_path / "assistant.key"))
+    with pytest.raises(ValueError):
+        assistant_key_store.save_key("short")
+    with pytest.raises(ValueError):
+        assistant_key_store.save_key("sk-abcdefghijklmnop\u0000")
+
+
+def test_stale_temp_file_does_not_block_save(tmp_path, monkeypatch) -> None:
+    monkeypatch.setenv("BINARYREPAIR_ASSISTANT_KEY_FILE", str(tmp_path / "assistant.key"))
+    (tmp_path / "assistant.key.tmp").write_text("stale", encoding="utf-8")
+    assistant_key_store.save_key("sk-stale-0123456789abcdef")
+    assert assistant_key_store.load_key() == "sk-stale-0123456789abcdef"
