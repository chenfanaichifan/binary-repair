@@ -0,0 +1,28 @@
+"""Schema for the analysis artifacts shown in the result report.
+
+These are candidate-derived explanations, not acceptance evidence.  They are
+stored as artifacts so the GUI/report can render exactly what was reviewed.
+"""
+
+from __future__ import annotations
+
+from pydantic import BaseModel, ConfigDict, Field
+
+
+class AnalysisArtifacts(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    schema_version: int = 1
+    candidate_sha256: str = Field(min_length=64, max_length=64)
+    expected_effects: list[str] = Field(min_length=1, max_length=32)
+    assumptions: list[str] = Field(default_factory=list, max_length=32)
+    uncertainties: list[str] = Field(default_factory=list, max_length=32)
+
+
+ANALYSIS_ROLES = {
+    "analysis_expected_effects": "expected_effects",
+    "analysis_assumptions": "assumptions",
+    "analysis_uncertainties": "uncertainties",
+}
+
+
+__all__ = ["ANALYSIS_ROLES", "AnalysisArtifacts"]
diff --git a/app/domain/assistant.py b/app/domain/assistant.py
new file mode 100644
index 0000000..d8c307a
--- /dev/null
+++ b/app/domain/assistant.py
@@ -0,0 +1,75 @@
+"""Assistant plan schema and deterministic v1 planner.
+
+The assistant is guidance only: it cannot approve, start a run, or write a
+verdict.  Plans are persisted as data so the controller/UI can render exactly
+what was proposed, with the mode and model metadata visible.
+"""
+
+from __future__ import annotations
+
+from typing import Literal
+
+from pydantic import BaseModel, ConfigDict, Field
+
+
+class AssistantStep(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    id: str = Field(min_length=1, max_length=64)
+    title: str = Field(min_length=1, max_length=200)
+    detail: str = Field(min_length=1, max_length=2000)
+    state: Literal["next", "waiting", "done", "blocked"] = "next"
+
+
+class AssistantQuestion(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    id: str = Field(min_length=1, max_length=64)
+    prompt: str = Field(min_length=1, max_length=1000)
+    options: list[str] = Field(default_factory=list, max_length=8)
+
+
+class AssistantPlan(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    schema_version: Literal[1] = 1
+    job_id: str = Field(min_length=1, max_length=64)
+    mode: Literal["scripted", "llm"]
+    summary: str = Field(min_length=1, max_length=2000)
+    steps: list[AssistantStep] = Field(min_length=1, max_length=16)
+    questions: list[AssistantQuestion] = Field(default_factory=list, max_length=8)
+    model: str | None = Field(default=None, max_length=200)
+    fallback_reason: str | None = Field(default=None, max_length=500)
+
+
+def deterministic_plan(job: dict) -> AssistantPlan:
+    """A stable plan derived only from job state; never from a model."""
+    job_id = str(job.get("id") or "")
+    phase = str(job.get("phase") or "draft")
+    approved = bool((job.get("contract") or {}).get("approved"))
+    steps = [
+        AssistantStep(id="input", title="确认样本与输入",
+                      detail="检查原始 ELF、缺陷描述、复现输入和有效输入测试。",
+                      state="done"),
+        AssistantStep(id="contract", title="复核安全契约",
+                      detail="确认有效输入域、禁止行为与 invalid 输入结果；批准前不能启动。",
+                      state="done" if approved else "blocked"),
+        AssistantStep(id="route_a", title="Route A 指令修复",
+                      detail="生成/检查指令级候选；无法安全放置时记录 unsupported。",
+                      state="next" if approved else "waiting"),
+        AssistantStep(id="route_b", title="Route B recovered-C 修复",
+                      detail="先做 unchanged round-trip，再做安全编辑和回填。",
+                      state="waiting"),
+        AssistantStep(id="acceptance", title="V0–V5 共享验收",
+                      detail="两路线使用同一测试和契约；required 未通过不得写 success。",
+                      state="waiting"),
+    ]
+    if phase in {"finished", "cancelled"}:
+        steps[-1].state = "done" if phase == "finished" else "blocked"
+    return AssistantPlan(
+        job_id=job_id,
+        mode="scripted",
+        summary="按输入 → 契约 → 双路线 → 共享验收推进；助手只给建议，不改变 verdict。",
+        steps=steps,
+        questions=[],
+    )
+
+
+__all__ = ["AssistantPlan", "AssistantQuestion", "AssistantStep", "deterministic_plan"]
diff --git a/app/domain/evidence.py b/app/domain/evidence.py
new file mode 100644
index 0000000..59bc3bd
--- /dev/null
+++ b/app/domain/evidence.py
@@ -0,0 +1,145 @@
+"""Evidence-envelope validation for acceptance.
+
+A persisted ``passed`` result is only meaningful when its artifact row has bytes
+on disk that match the recorded hash and belong to this job/attempt.  The pure
+acceptance engine remains I/O-free; this module is the boundary that turns a
+declaration into validated evidence.
+"""
+
+from __future__ import annotations
+
+import hashlib
+from pathlib import Path
+from typing import Any
+
+from app.db.connection import connect
+
+
+class EvidenceError(ValueError):
+    """Evidence is missing, outside the job store, or has the wrong bytes."""
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _resolve_store_path(data_dir: str | Path, relative_path: str) -> Path:
+    root = Path(data_dir).resolve()
+    candidate = (root / relative_path).resolve()
+    job_root = (root / "jobs").resolve()
+    try:
+        candidate.relative_to(job_root)
+    except ValueError as exc:
+        raise EvidenceError(f"artifact path escapes the job store: {relative_path}") from exc
+    if candidate.is_symlink():
+        raise EvidenceError(f"artifact path is a symlink: {relative_path}")
+    return candidate
+
+
+def verify_artifact(
+    *,
+    data_dir: str | Path,
+    job_id: str,
+    attempt_id: str,
+    artifact_id: str,
+    gate: str,
+    require_attempt: bool = False,
+) -> dict[str, Any]:
+    """Return the verified artifact row or raise EvidenceError.
+
+    V0 may use a job-level original artifact (attempt_id NULL).  V1-V5 must be
+    bound to this attempt, so evidence copied from another attempt cannot pass.
+    """
+
+    connection = connect(data_dir)
+    try:
+        row = connection.execute(
+            "SELECT * FROM artifacts WHERE id = ? AND job_id = ?",
+            (artifact_id, job_id),
+        ).fetchone()
+    finally:
+        connection.close()
+    if row is None:
+        raise EvidenceError(f"{gate} evidence artifact is not part of job {job_id}: {artifact_id}")
+    bound_attempt = row["attempt_id"]
+    if gate == "V0" and not require_attempt:
+        if bound_attempt not in (None, attempt_id):
+            raise EvidenceError(f"{gate} evidence belongs to another attempt: {bound_attempt}")
+    elif bound_attempt != attempt_id:
+        raise EvidenceError(f"{gate} evidence belongs to another attempt: {bound_attempt}")
+
+    path = _resolve_store_path(data_dir, str(row["relative_path"]))
+    if not path.is_file():
+        raise EvidenceError(f"{gate} evidence file is missing: {path}")
+    actual_size = path.stat().st_size
+    if actual_size != int(row["size_bytes"]):
+        raise EvidenceError(
+            f"{gate} evidence size mismatch: recorded {row['size_bytes']}, actual {actual_size}"
+        )
+    actual_hash = _sha256(path)
+    if actual_hash != str(row["sha256"]):
+        raise EvidenceError(f"{gate} evidence hash mismatch: {actual_hash} != {row['sha256']}")
+    return {
+        "id": str(row["id"]),
+        "attempt_id": bound_attempt,
+        "relative_path": str(row["relative_path"]),
+        "sha256": actual_hash,
+        "size_bytes": actual_size,
+    }
+
+
+def verify_evidence_map(
+    *,
+    data_dir: str | Path,
+    job_id: str,
+    attempt_id: str,
+    evidence: dict[str, str],
+    require_attempt: bool = False,
+) -> dict[str, dict[str, Any]]:
+    verified = {}
+    for gate, artifact_id in evidence.items():
+        if not artifact_id:
+            continue
+        verified[gate] = verify_artifact(
+            data_dir=data_dir,
+            job_id=job_id,
+            attempt_id=attempt_id,
+            artifact_id=artifact_id,
+            gate=gate,
+            require_attempt=require_attempt,
+        )
+    return verified
+
+
+__all__ = ["EvidenceError", "verify_artifact", "verify_candidate_binding", "verify_evidence_map"]
+
+
+def verify_candidate_binding(
+    *,
+    data_dir: str | Path,
+    job_id: str,
+    attempt_id: str,
+    candidate_sha256: str,
+    evidence: dict[str, str],
+) -> dict[str, Any]:
+    """Require at least one verified artifact to be the declared candidate bytes.
+
+    A string in result JSON is not a binding; the bytes must exist in the job
+    store under this attempt and hash to the declared candidate.
+    """
+    allowed = {f"V{i}" for i in range(6)}
+    filtered = {gate: artifact_id for gate, artifact_id in evidence.items() if gate in allowed}
+    verified = verify_evidence_map(
+        data_dir=data_dir, job_id=job_id, attempt_id=attempt_id,
+        evidence=filtered, require_attempt=True,
+    )
+    for gate, record in verified.items():
+        if record["sha256"] == candidate_sha256:
+            return record
+    raise EvidenceError(
+        f"candidate_sha256 {candidate_sha256} is not bound to any verified evidence artifact"
+    )
diff --git a/app/services/assistant.py b/app/services/assistant.py
new file mode 100644
index 0000000..2a16206
--- /dev/null
+++ b/app/services/assistant.py
@@ -0,0 +1,130 @@
+"""Persistence and mode selection for assistant plans."""
+
+from __future__ import annotations
+
+import json
+import os
+import uuid
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+from app.db.connection import connect
+from app.domain.assistant import AssistantPlan, deterministic_plan
+from app.services import jobs, model_calls
+from binaryrepair_ai.client import DeepSeekClient
+from binaryrepair_ai.settings import Settings
+
+
+def _now() -> str:
+    return datetime.now(timezone.utc).isoformat(timespec="seconds")
+
+
+def get_plan(job_id: str, *, data_dir: str | Path) -> dict[str, Any] | None:
+    connection = connect(data_dir)
+    try:
+        row = connection.execute(
+            "SELECT * FROM assistant_plans WHERE job_id = ? ORDER BY created_at DESC, id DESC LIMIT 1",
+            (job_id,),
+        ).fetchone()
+    finally:
+        connection.close()
+    if row is None:
+        return None
+    return {
+        "id": row["id"], "job_id": row["job_id"], "mode": row["mode"],
+        "plan": json.loads(row["plan_json"]), "model": row["model"],
+        "usage": json.loads(row["usage_json"]) if row["usage_json"] else None,
+        "created_at": row["created_at"],
+    }
+
+
+def save_plan(job_id: str, plan: AssistantPlan, *, data_dir: str | Path,
+              model: str | None = None, usage: dict | None = None) -> dict[str, Any]:
+    if plan.job_id != job_id:
+        raise ValueError("plan job_id does not match job")
+    plan_id = uuid.uuid4().hex
+    connection = connect(data_dir)
+    try:
+        with connection:
+            connection.execute(
+                "INSERT INTO assistant_plans "
+                "(id, job_id, mode, plan_json, model, usage_json, created_at) "
+                "VALUES (?, ?, ?, ?, ?, ?, ?)",
+                (plan_id, job_id, plan.mode, plan.model_dump_json(),
+                 model, json.dumps(usage, sort_keys=True) if usage else None, _now()),
+            )
+    finally:
+        connection.close()
+    return {"id": plan_id, "job_id": job_id, "mode": plan.mode,
+            "plan": plan.model_dump(), "model": model, "usage": usage}
+
+
+def _job_context(job: Any, *, data_dir: str | Path) -> dict[str, Any]:
+    return {
+        "id": job.id,
+        "filename": job.filename,
+        "defect_description": job.defect_description,
+        "phase": job.phase,
+        "original_sha256": job.original_sha256,
+    }
+
+
+def _llm_plan(job: Any, *, data_dir: str | Path, client: Any) -> tuple[AssistantPlan, dict | None, str | None]:
+    context = _job_context(job, data_dir=data_dir)
+    messages = [
+        {"role": "system", "content": (
+            "You are a BinaryRepair assistant. Return JSON only, matching the "
+            "AssistantPlan schema: schema_version, job_id, mode, summary, steps "
+            "(id/title/detail/state), questions (id/prompt/options). "
+            "You must not approve contracts, start runs, or claim a verdict."
+        )},
+        {"role": "user", "content": json.dumps(context, sort_keys=True)},
+    ]
+    response = client.chat_json(messages, max_tokens=1200, thinking=False)
+    raw = getattr(response, "content", "")
+    payload = json.loads(raw)
+    plan = AssistantPlan.model_validate(payload)
+    if plan.job_id != job.id:
+        raise ValueError("LLM plan job_id does not match job")
+    plan.mode = "llm"
+    plan.model = getattr(response, "model", None)
+    plan.fallback_reason = None
+    usage = getattr(response, "usage", None)
+    return plan, usage, plan.model
+
+
+def generate_plan(job_id: str, *, data_dir: str | Path,
+                  mode: str | None = None, client: Any | None = None) -> dict[str, Any]:
+    """Generate a plan. LLM failures fall back to the deterministic planner."""
+    job = jobs.get_job(job_id, data_dir=data_dir)
+    if job is None:
+        raise ValueError("job not found")
+    selected = (mode or os.environ.get("BINARYREPAIR_ASSISTANT_MODE", "scripted")).strip().lower()
+    if selected == "scripted":
+        return save_plan(job.id, deterministic_plan(_job_context(job, data_dir=data_dir)),
+                         data_dir=data_dir)
+    if selected == "llm":
+        try:
+            if client is None:
+                settings = Settings.from_env()
+                client = DeepSeekClient(settings)
+            plan, usage, model = _llm_plan(job, data_dir=data_dir, client=client)
+            call_id = model_calls.record_call(
+                data_dir=data_dir, model_requested=model or "unknown",
+                model_returned=model, status="accepted_for_assistant",
+                route="assistant", usage=usage,
+            )
+            stored_usage = dict(usage or {})
+            stored_usage["model_call_id"] = call_id
+            return save_plan(job.id, plan, data_dir=data_dir, model=model,
+                             usage=stored_usage)
+        except Exception as exc:
+            fallback = deterministic_plan(_job_context(job, data_dir=data_dir))
+            fallback.fallback_reason = f"llm unavailable: {type(exc).__name__}: {exc}"[:500]
+            return save_plan(job.id, fallback, data_dir=data_dir,
+                             usage={"fallback": True})
+    raise ValueError(f"unknown assistant mode: {selected!r}")
+
+
+__all__ = ["generate_plan", "get_plan", "save_plan"]
