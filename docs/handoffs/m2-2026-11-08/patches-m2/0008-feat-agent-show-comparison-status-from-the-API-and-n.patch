From 34d054ce039f3d0e233e45b9297b1c92a1ecadf5 Mon Sep 17 00:00:00 2001
From: chenfanaichifan <2350776866@qq.com>
Date: Sun, 8 Nov 2026 00:27:27 +0800
Subject: [PATCH 8/8] feat(agent): show comparison status from the API and
 never infer a pass

179 contract: GET /api/jobs/{id}/comparison returns status not_provided|available. The console now renders not_provided and transport failures as unavailable, shows only the artifact count when available, and does not parse field names it does not own.
---
 app/static/js/agent.js      | 51 ++++++++++++++++++++++++++++++++++++-
 tests/test_agent_console.py | 12 ++++++++-
 2 files changed, 61 insertions(+), 2 deletions(-)

diff --git a/app/static/js/agent.js b/app/static/js/agent.js
index 0efd4c7..fd8d44f 100644
--- a/app/static/js/agent.js
+++ b/app/static/js/agent.js
@@ -315,6 +315,36 @@
 
   var evidenceCache = {};
   var attemptsCache = { jobId: "", available: null, items: [] };
+  var comparisonCache = null; // { status, detail, artifacts }
+
+  // 179 契约：GET /api/jobs/{id}/comparison
+  // not_provided / 端点不可用一律按不可用显示，绝不显示通过，也不猜字段名。
+  function fetchComparison(jobId) {
+    if (!jobId) { comparisonCache = null; return Promise.resolve(null); }
+    return fetch("/api/jobs/" + encodeURIComponent(jobId) + "/comparison", {
+      headers: { Accept: "application/json" }
+    }).then(function (response) {
+      if (!response.ok) {
+        comparisonCache = { status: "unavailable", detail: "HTTP " + response.status, artifacts: [] };
+        return comparisonCache;
+      }
+      return response.json();
+    }).then(function (payload) {
+      if (!payload || typeof payload.status !== "string") {
+        comparisonCache = { status: "unavailable", detail: "payload 不可解析", artifacts: [] };
+        return comparisonCache;
+      }
+      comparisonCache = {
+        status: payload.status,
+        detail: payload.detail || "",
+        artifacts: Array.isArray(payload.artifacts) ? payload.artifacts : []
+      };
+      return comparisonCache;
+    }).catch(function () {
+      comparisonCache = { status: "unavailable", detail: "请求失败", artifacts: [] };
+      return comparisonCache;
+    });
+  }
 
   function fetchAttemptEvidence(attemptId) {
     if (evidenceCache[attemptId]) return Promise.resolve(evidenceCache[attemptId]);
@@ -1072,6 +1102,24 @@
     box.appendChild(wrap);
   }
 
+  function appendComparisonBox(box) {
+    // 只看 status；comparison 的内容不做字段级解析，未提供就是未提供。
+    if (!comparisonCache) return;
+    var wrap = el("div", "agent-card");
+    wrap.dataset.testid = "agent-comparison";
+    wrap.appendChild(el("p", "agent-card-title", "行为对比"));
+    var text;
+    if (comparisonCache.status === "available") {
+      text = "已提供（" + comparisonCache.artifacts.length + " 个 artifact）";
+    } else if (comparisonCache.status === "not_provided") {
+      text = "未提供（not_provided）";
+    } else {
+      text = "不可用（" + (comparisonCache.detail || "unknown") + "）";
+    }
+    wrap.appendChild(el("p", null, "comparison：" + text));
+    box.appendChild(wrap);
+  }
+
   function renderDiagnostics(view) {
     // 结论只读 verdict，绝不由前端推断。
     var verdictText = "结论：—";
@@ -1118,6 +1166,7 @@
     clear(box);
     if (view.receiptPending) return; // 未回传：只显示占位，不渲染 not_run
     appendScopeBox(box, view);
+    appendComparisonBox(box);
 
     view.routeKeys.forEach(function (key) {
       var route = view.routes[key];
@@ -1259,7 +1308,7 @@
   function tick() {
     if (!state.jobId) return;
     if (FIXTURE_MODE) return;
-    Promise.all([fetchLiveSnapshot(), fetchAttempts(state.jobId)]).then(function (results) {
+    Promise.all([fetchLiveSnapshot(), fetchAttempts(state.jobId), fetchComparison(state.jobId)]).then(function (results) {
       var data = results[0];
       state.snapshot = data;
       setText("agent-poll", "轮询中 · " + new Date().toLocaleTimeString());
diff --git a/tests/test_agent_console.py b/tests/test_agent_console.py
index 13087c3..6637332 100644
--- a/tests/test_agent_console.py
+++ b/tests/test_agent_console.py
@@ -125,6 +125,15 @@ def test_scope_and_bounded_never_turn_missing_into_pass():
 def test_snapshot_id_is_accepted_as_job_id():
     # P1 snapshot uses "id"; the console must not show an empty job chip for it.
     assert 'jobId: data.job_id || data.id || state.jobId || ""' in AGENT_JS
+
+
+def test_comparison_is_only_shown_when_the_api_says_available():
+    # 179 contract: status is the only source of truth; not_provided is never a pass.
+    assert 'comparisonCache.status === "available"' in AGENT_JS
+    assert 'text = "未提供（not_provided）"' in AGENT_JS
+    assert 'text = "不可用（"' in AGENT_JS
+    assert '"comparison：" + text' in AGENT_JS
+    assert "comparison：通过" not in AGENT_JS
     assert '"超出边界"' in AGENT_JS
 
 
@@ -156,9 +165,10 @@ def test_no_model_calls_or_new_transport():
         assert banned not in AGENT_JS, banned
     # Read paths: the snapshot, the attempts timeline, the job-less plan
     # route, and per-attempt evidence (all same-origin GETs).
-    assert AGENT_JS.count("fetch(") == 4
+    assert AGENT_JS.count("fetch(") == 5
     assert 'fetch("/api/jobs/" + encodeURIComponent(state.jobId)' in AGENT_JS
     assert 'fetch("/api/jobs/" + encodeURIComponent(jobId) + "/attempts"' in AGENT_JS
+    assert 'fetch("/api/jobs/" + encodeURIComponent(jobId) + "/comparison"' in AGENT_JS
     assert 'fetch("/api/assistant/plan"' in AGENT_JS
     assert 'fetch("/api/attempts/" + encodeURIComponent(attemptId) + "/evidence"' in AGENT_JS
     # Write path: the existing create-job form endpoint only, with CSRF.
