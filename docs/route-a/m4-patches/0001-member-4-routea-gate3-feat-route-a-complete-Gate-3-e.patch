+﻿#!/usr/bin/env bash
+# Route A Gate 3 VM check — run inside the disposable guest, never on the host.
+#
+# Purpose: run the Route A tests, build the candidate, audit it, and write the
+# static evidence bundle. It does NOT execute the candidate: the six frozen
+# cases and the isolation evidence are separate, manual steps (handoff 11 §3
+# items 4-5) because they require the snapshot/egress/uid-1003 controls.
+#
+# This script is unverified: it has not been run on the host. Its first real run
+# is the VM acceptance run. A missing dependency is an error, not a pass.
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$ROOT"
+CASE="$ROOT/fixtures/public/CWE121_src_char_declare_cpy_51b"
+CONTRACT="$CASE/contract.route-a-v1.json"
+RUN_ID="${RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)}"
+OUT="${OUT:-$ROOT/var/jobs/m4-gate3/$RUN_ID/static}"
+
+EXPECTED_CANDIDATE="f3cb9cbb503fb0d47ebebab7053fa2ed37b7876ffe5122157d31fefc783f9fa7"
+EXPECTED_CONTRACT="ba33b4d070b8799b778a9ca1a257190079627bda72b5c42933edfebb0f5d8fc4"
+
+echo "== environment =="
+uname -a
+python3 --version
+python3 -c "import elftools, capstone; print('pyelftools', elftools.__version__); print('capstone', capstone.__version__)"
+command -v readelf >/dev/null || { echo "ERROR: readelf missing" >&2; exit 2; }
+command -v objdump >/dev/null || { echo "ERROR: objdump missing" >&2; exit 2; }
+readelf --version | head -1
+objdump --version | head -1
+
+echo "== frozen inputs =="
+sha256sum "$CASE/original.elf"
+echo "expected original: aa42815704d9ffc65b3a49821b3cc6189126a738a7e02d668dec250982408393"
+echo "expected contract: $EXPECTED_CONTRACT"
+python3 - "$CONTRACT" <<'PY'
+import json, sys
+sys.path.insert(0, ".")
+from app.domain.contracts import SecurityContract
+contract = SecurityContract.from_dict(json.load(open(sys.argv[1], encoding="utf-8")))
+print("contract_sha256=", contract.sha256())
+PY
+
+echo "== tests (guest/CI only) =="
+python3 -m pytest tests/test_routea_manifest.py tests/test_routea_cave.py -q -p no:cacheprovider
+
+echo "== build + audit + reproducibility + static bundle =="
+mkdir -p "$OUT"
+python3 -m routea.cave bundle \
+  --elf "$CASE/original.elf" --contract "$CONTRACT" \
+  --cave 0x4018e9 --cave-size 1815 \
+  --out-dir "$OUT" --scope-authorized
+
+echo "== candidate identity =="
+sha256sum "$OUT/candidate.elf"
+echo "expected candidate: $EXPECTED_CANDIDATE"
+
+cat <<'NEXT'
+== still manual: the runtime half of Gate 3 ==
+1. Runtime cave probe under the isolation wrapper: map 0x401000-0x401fff r-xp,
+   candidate file bytes == memory at 0x4018e9, an instruction at the cave entry
+   executes. Breakpoints: 0x401304 (site), 0x4018e9 (cave), 0x401309 (resume).
+2. Six frozen cases on the candidate from a reverted snapshot, no egress, uid 1003:
+   python3 routeb/run_manifest_repaired.py --binary <candidate> \
+     --tests fixtures/public/CWE121_src_char_declare_cpy_51b/tests \
+     --out var/jobs/m4-gate3/<run-id>/manifest-repaired.json
+3. Original V0 shape (documented 4/6) on the same session.
+4. Record candidate SHA-256 before and after each run, wrapper attestation, and
+   the snapshot revert log. Items 4-5 stay not_run until this exists.
+NEXT
