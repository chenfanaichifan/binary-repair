+def test_audit_rejects_byte_outside_declared_intervals(tmp_path: Path) -> None:
+    candidate, _manifest = build(tmp_path)
+    data = bytearray(candidate.read_bytes())
+    # 0x401200 maps to file offset 0x1200 for this non-PIE ELF; it is untouched .text
+    data[0x1200] ^= 0xFF
+    tampered = tmp_path / "tampered-text.elf"
+    tampered.write_bytes(bytes(data))
+    audit = audit_cave_layout(ELF, tampered, plan())
+    assert audit["pass"] is False
+    assert audit["checks"]["changed_bytes_inside_declared_intervals"] is False
+
+
+def test_audit_rejects_header_tamper(tmp_path: Path) -> None:
+    candidate, _manifest = build(tmp_path)
+    data = bytearray(candidate.read_bytes())
+    fields = header_fields(candidate)
+    change_index = _manifest.header_changes[0]["index"]
+    entry = fields["e_phoff"] + change_index * fields["e_phentsize"]
+    data[entry + 40:entry + 48] = (0x8E9).to_bytes(8, "little")  # shrink p_memsz
+    tampered = tmp_path / "tampered-header.elf"
+    tampered.write_bytes(bytes(data))
+    audit = audit_cave_layout(ELF, tampered, plan())
+    assert audit["pass"] is False
+    assert audit["checks"]["rx_end_file_backed"] is False
+
