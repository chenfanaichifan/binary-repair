+def test_cave_and_register_static_checks(tmp_path: Path) -> None:
+    candidate, _manifest = build(tmp_path)
+    audit = audit_cave_layout(ELF, candidate, plan())
+    checks = audit["checks"]
+    assert audit["pass"] is True, audit["failed"]
