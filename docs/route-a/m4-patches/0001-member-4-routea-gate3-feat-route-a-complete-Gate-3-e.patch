+"""Complete edit manifest (schema 2) and ELF fact extraction for Route A.
+
+Why this module exists
+----------------------
+Gate 3 (``docs_BinaryRepair/handoffs/11-environment-evidence-confirmations.md`` §3
+item 2) requires the edit manifest to list **every** changed and added interval,
+the header fields that changed, the detour, and the displaced bytes. The original
+probe manifest only listed a redirect and a mapping size, which is not enough for
+an independent reviewer.
+
+This module provides:
+
+* :class:`CaveManifest` — the complete, reviewable manifest for the strategy-C
+  cave repair;
+* :func:`elf_facts` / :func:`program_headers` / :func:`section_headers` /
+  :func:`symbols` / :func:`relocations` / :func:`dynamic_entries` /
+  :func:`cet_report` — one structured view of the ELF used by the audit;
+* :func:`tools_report` — the library/tool versions that must be recorded.
+
+Nothing here executes or modifies a binary; it only reads bytes and ELF metadata.
+The actual patch is written by :mod:`routea.cave`.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.metadata
+import platform
+import struct
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+from elftools.elf.elffile import ELFFile
+from elftools.elf.sections import SymbolTableSection
+
+MANIFEST_SCHEMA_VERSION = 2
+PT_LOAD = 1
+
+
+def sha256_bytes(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def sha256_file(path: Path) -> str:
+    return sha256_bytes(path.read_bytes())
+
+
+def _rel32(value: int) -> str:
+    return hex(value & 0xFFFFFFFFFFFFFFFF)
+
+
+# ---------------------------------------------------------------------------
+# ELF facts
+
+
+def program_headers(path: Path) -> list[dict[str, Any]]:
+    """Every program header, indexed exactly like the file table."""
+    out: list[dict[str, Any]] = []
+    with path.open("rb") as fh:
+        elf = ELFFile(fh)
+        for index in range(elf.num_segments()):
+            seg = elf.get_segment(index)
+            out.append(
+                {
+                    "index": index,
+                    "type": seg["p_type"],
+                    "flags": int(seg["p_flags"]),
+                    "offset": int(seg["p_offset"]),
+                    "vaddr": int(seg["p_vaddr"]),
+                    "paddr": int(seg["p_paddr"]),
+                    "filesz": int(seg["p_filesz"]),
+                    "memsz": int(seg["p_memsz"]),
+                    "align": int(seg["p_align"]),
+                }
+            )
+    return out
+
+
+def header_fields(path: Path) -> dict[str, Any]:
+    with path.open("rb") as fh:
+        elf = ELFFile(fh)
+        header = elf.header
+        return {
+            "e_ident_class": int(header["e_ident"]["EI_CLASS"]),
+            "e_ident_data": int(header["e_ident"]["EI_DATA"]),
+            "e_type": header["e_type"],
+            "e_machine": header["e_machine"],
+            "e_version": int(header["e_version"]),
+            "e_entry": int(header["e_entry"]),
+            "e_phoff": int(header["e_phoff"]),
+            "e_shoff": int(header["e_shoff"]),
+            "e_flags": int(header["e_flags"]),
+            "e_ehsize": int(header["e_ehsize"]),
+            "e_phentsize": int(header["e_phentsize"]),
+            "e_phnum": int(header["e_phnum"]),
+            "e_shentsize": int(header["e_shentsize"]),
+            "e_shnum": int(header["e_shnum"]),
+            "e_shstrndx": int(header["e_shstrndx"]),
+        }
+
+
+def table_bytes(path: Path, *, kind: str) -> bytes:
+    """Raw bytes of the program-header or section-header table."""
+    raw = path.read_bytes()
+    fields = header_fields(path)
+    if kind == "program":
+        start, count, size = fields["e_phoff"], fields["e_phnum"], fields["e_phentsize"]
+    elif kind == "section":
+        start, count, size = fields["e_shoff"], fields["e_shnum"], fields["e_shentsize"]
+    else:  # pragma: no cover - programmer error
+        raise ValueError(f"unknown table kind: {kind!r}")
+    return raw[start : start + count * size]
+
+
+def section_headers(path: Path) -> list[dict[str, Any]]:
+    out: list[dict[str, Any]] = []
+    with path.open("rb") as fh:
+        elf = ELFFile(fh)
+        for index, sec in enumerate(elf.iter_sections()):
+            flags = sec["sh_flags"]
+            out.append(
+                {
+                    "index": index,
+                    "name": sec.name,
+                    "type": sec["sh_type"],
+                    "flags": int(flags),
+                    "alloc": bool(flags & 0x2),
+                    "exec": bool(flags & 0x4),
+                    "writable": bool(flags & 0x1),
+                    "addr": int(sec["sh_addr"]),
+                    "offset": int(sec["sh_offset"]),
+                    "size": int(sec["sh_size"]),
+                }
+            )
+    return out
+
+
+def symbols(path: Path) -> list[dict[str, Any]]:
+    out: list[dict[str, Any]] = []
+    with path.open("rb") as fh:
+        elf = ELFFile(fh)
+        for sec in elf.iter_sections():
+            if not isinstance(sec, SymbolTableSection):
+                continue
+            for sym in sec.iter_symbols():
+                if not sym.name:
+                    continue
+                out.append(
+                    {
+                        "name": sym.name,
+                        "value": int(sym["st_value"]),
+                        "size": int(sym["st_size"]),
+                        "type": sym["st_info"]["type"],
+                        "bind": sym["st_info"]["bind"],
+                        "section": sec.name,
+                    }
+                )
+    return out
+
+
+def relocations(path: Path) -> list[dict[str, Any]]:
+    out: list[dict[str, Any]] = []
+    with path.open("rb") as fh:
+        elf = ELFFile(fh)
+        for sec in elf.iter_sections():
+            if sec["sh_type"] not in ("SHT_RELA", "SHT_REL"):
+                continue
+            for rel in sec.iter_relocations():
+                out.append(
+                    {
+                        "section": sec.name,
+                        "offset": int(rel["r_offset"]),
+                        "type": int(rel["r_info_type"]),
+                    }
+                )
+    return out
+
+
+def dynamic_entries(path: Path) -> list[dict[str, Any]]:
+    out: list[dict[str, Any]] = []
+    with path.open("rb") as fh:
+        elf = ELFFile(fh)
+        sec = elf.get_section_by_name(".dynamic")
+        if sec is None:
+            return out
+        for tag in sec.iter_tags():
+            raw = tag.entry.get("d_val", tag.entry.get("d_ptr", 0))
+            out.append({"tag": str(tag.entry["d_tag"]),
+                        "value": raw if isinstance(raw, int) else str(raw)})
+    return out
+
+
+def section_content_sha256(path: Path, name: str) -> str | None:
+    with path.open("rb") as fh:
+        elf = ELFFile(fh)
+        sec = elf.get_section_by_name(name)
+        if sec is None:
+            return None
+        return sha256_bytes(sec.data())
+
+
+CET_PROPERTY_NOTE = "NT_GNU_PROPERTY_TYPE_0"
+X86_FEATURE_PROPERTY = 0xC0000002
+
+
+def cet_report(path: Path) -> dict[str, Any]:
+    """Report the compile-time CET property note, not a runtime guarantee.
+
+    Bit 0 is IBT, bit 1 is SHSTK in the x86 feature property. "CET enabled" in
+    the contract is an assumption to be confirmed, not proof of runtime
+    enforcement (handoff 09 §5 item 8).
+    """
+    try:
+        with path.open("rb") as fh:
+            elf = ELFFile(fh)
+            for seg in elf.iter_segments():
+                if seg["p_type"] != "PT_NOTE":
+                    continue
+                for note in seg.iter_notes():
+                    if note["n_type"] != CET_PROPERTY_NOTE:
+                        continue
+                    desc = note["n_desc"]
+                    if not isinstance(desc, (bytes, bytearray)):
+                        continue
+                    offset = 0
+                    while offset + 8 <= len(desc):
+                        prop_type, prop_size = struct.unpack_from("<II", desc, offset)
+                        offset += 8
+                        data = bytes(desc[offset : offset + prop_size])
+                        offset += prop_size
+                        if prop_type == X86_FEATURE_PROPERTY and len(data) >= 4:
+                            bits = struct.unpack_from("<I", data, 0)[0]
+                            return {
+                                "available": True,
+                                "ibt": bool(bits & 1),
+                                "shstk": bool(bits & 2),
+                                "raw_feature_bits": hex(bits),
+                                "note": "compile-time GNU property; runtime enforcement unverified",
+                            }
+        return {"available": False, "reason": "no x86 feature property note"}
+    except Exception as exc:  # pragma: no cover - defensive
+        return {"available": False, "reason": f"note parse failed: {exc}"}
+
+
+def tools_report() -> dict[str, str]:
+    def version(dist: str) -> str:
+        try:
+            return importlib.metadata.version(dist)
+        except importlib.metadata.PackageNotFoundError:
+            return "not_installed"
+
+    return {
+        "python": platform.python_version(),
+        "pyelftools": version("pyelftools"),
+        "capstone": version("capstone"),
+        "lief": version("lief"),
+        "platform": platform.platform(),
+    }
+
+
+def elf_facts(path: Path) -> dict[str, Any]:
+    """One structured, hashable view of every ELF fact the audit compares."""
+    phdrs = program_headers(path)
+    sections = section_headers(path)
+    return {
+        "sha256": sha256_file(path),
+        "size": path.stat().st_size,
+        "header": header_fields(path),
+        "program_headers": phdrs,
+        "program_header_table_sha256": sha256_bytes(table_bytes(path, kind="program")),
+        "section_headers": sections,
+        "section_header_table_sha256": sha256_bytes(table_bytes(path, kind="section")),
+        "symbols": symbols(path),
+        "relocations": relocations(path),
+        "dynamic": dynamic_entries(path),
+        "cet": cet_report(path),
+        "section_content_sha256": {
+            name: section_content_sha256(path, name)
+            for name in (
+                ".dynamic",
+                ".dynsym",
+                ".dynstr",
+                ".rela.dyn",
+                ".rela.plt",
+                ".rel.dyn",
+                ".rel.plt",
+                ".got",
+                ".got.plt",
+                ".plt",
+                ".plt.sec",
+                ".init",
+                ".fini",
+                ".rodata",
+                ".data",
+                ".bss",
+            )
+        },
+    }
+
+
+# ---------------------------------------------------------------------------
+# Manifest
+
+
+@dataclass
+class CaveManifest:
+    """Complete Gate 3 edit manifest for the cave strategy (schema 2)."""
+
+    original_sha256: str
+    patched_sha256: str
+    original_size: int
+    patched_size: int
+    function: dict[str, Any]
+    redirect: dict[str, Any]
+    cave: dict[str, Any]
+    added: list[dict[str, Any]]
+    header_changes: list[dict[str, Any]]
+    changed_file_intervals: list[dict[str, int]]
+    intended_intervals: list[dict[str, int]]
+    relocations_added: list[dict[str, Any]]
+    writer: dict[str, Any]
+    termination: dict[str, Any]
+    tools: dict[str, str] = field(default_factory=dict)
+    scope_authorized: bool = False
+    audit: dict[str, Any] = field(default_factory=dict)
+    strategy: str = "cave_call_redirect"
+    schema_version: int = MANIFEST_SCHEMA_VERSION
+
+    def to_dict(self) -> dict[str, Any]:
+        return {
+            "schema_version": self.schema_version,
+            "strategy": self.strategy,
+            "original_sha256": self.original_sha256,
+            "patched_sha256": self.patched_sha256,
+            "original_size": self.original_size,
+            "patched_size": self.patched_size,
+            "function": self.function,
+            "redirect": self.redirect,
+            "cave": self.cave,
+            "added": self.added,
+            "header_changes": self.header_changes,
+            "changed_file_intervals": self.changed_file_intervals,
+            "intended_intervals": self.intended_intervals,
+            "relocations_added": self.relocations_added,
+            "writer": self.writer,
+            "termination": self.termination,
+            "tools": self.tools,
+            "scope_authorized": self.scope_authorized,
+            "audit": self.audit,
+        }
+
+    # Fields a reviewer must be able to read for Gate 3 item 2. Kept as a class
+    # attribute so tests can assert the manifest is complete instead of trusting
+    # a hand-written comment.
+    REQUIRED_KEYS = (
+        "schema_version",
+        "strategy",
+        "original_sha256",
+        "patched_sha256",
+        "original_size",
+        "patched_size",
+        "function",
+        "redirect",
+        "cave",
+        "added",
+        "header_changes",
+        "changed_file_intervals",
+        "intended_intervals",
+        "relocations_added",
+        "writer",
+        "termination",
+        "tools",
+        "scope_authorized",
+        "audit",
+    )
+
+    def missing_keys(self) -> list[str]:
+        data = self.to_dict()
+        return [key for key in self.REQUIRED_KEYS if key not in data]
+
+    def empty_required_keys(self) -> list[str]:
+        """Keys whose value is empty but must carry evidence."""
+        data = self.to_dict()
+        must = (
+            "original_sha256",
+            "patched_sha256",
+            "function",
+            "redirect",
+            "cave",
+            "added",
+            "header_changes",
+            "changed_file_intervals",
+            "intended_intervals",
+            "writer",
+            "termination",
+        )
+        return [key for key in must if not data.get(key)]
+
+
+def manifest_sha256(manifest: dict[str, Any]) -> str:
+    import json
+
+    return sha256_bytes(
+        json.dumps(manifest, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    )
