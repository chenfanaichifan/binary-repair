+    assert redirect["vaddr"] == "0x401304"
+    assert redirect["original_hex"] == "e8c7fdffff"
+    assert redirect["new_hex"] == "e8e0050000"
+    assert redirect["target_vaddr"] == hex(CAVE_ADDR)
+    assert redirect["resume_at"] == "0x401309"
