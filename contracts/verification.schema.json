{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binaryrepair.local/contracts/verification.schema.json",
  "title": "Independent verification report",
  "description": "One independent verification report: target identity, generator and verifier identities, an explicit independence statement that excludes generator evidence, required checks (including layout-plan when a patch plan/layout evidence is exchanged), a fail-closed decision, evidence, limitations and a stable report sha256. decision=verified is only legal when independence.ok and independence.generator_evidence_excluded are true, at least one independent oracle check passed, no required check failed or was not run, and - when layout evidence is present - a passed layout-plan check and a passed independent oracle check exist; the checker enforces these cross-field rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target",
    "generator",
    "verifier",
    "independence",
    "checks",
    "decision",
    "evidence",
    "limitations",
    "report_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "arch",
        "bits",
        "endian",
        "target_scope"
      ],
      "properties": {
        "target_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "format": {
          "type": "string",
          "enum": [
            "elf",
            "macho",
            "pe"
          ]
        },
        "arch": {
          "type": "string",
          "enum": [
            "x86_64",
            "i386",
            "arm64"
          ]
        },
        "bits": {
          "type": "integer",
          "enum": [
            32,
            64
          ]
        },
        "endian": {
          "type": "string",
          "enum": [
            "little",
            "big"
          ]
        },
        "container": {
          "type": "string"
        },
        "target_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy"
          ],
          "properties": {
            "policy": {
              "type": "string",
              "enum": [
                "target_scoped",
                "whole_image",
                "analysis_only",
                "target_scoped_associated"
              ]
            },
            "name": {
              "type": "string"
            },
            "va": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator_id"
      ],
      "properties": {
        "generator_id": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier_id"
      ],
      "properties": {
        "verifier_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        }
      }
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "generator_evidence_excluded"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "generator_evidence_excluded": {
          "type": "boolean"
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "required",
          "detail"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{1,64}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "independent": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "verified",
        "rejected",
        "inconclusive",
        "not_run"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "patch_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "oracle_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "runner",
        "tier",
        "status"
      ],
      "properties": {
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "type": "string",
          "enum": [
            "native_run",
            "emulated_run",
            "static_only",
            "unavailable"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "executed",
            "not_run",
            "unavailable"
          ]
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected": {
          "type": "object"
        }
      }
    },
    "layout_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patch_plan_sha256",
        "replay_ok",
        "changed_ranges",
        "cave",
        "associated_changes"
      ],
      "properties": {
        "patch_plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "replay_ok": {
          "type": "boolean"
        },
        "changed_ranges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "original_offset",
              "size",
              "kind"
            ],
            "properties": {
              "original_offset": {
                "type": "integer",
                "minimum": 0
              },
              "candidate_offset": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "size": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "write",
                  "insert",
                  "replace",
                  "associated"
                ]
              }
            }
          }
        },
        "cave": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "va",
            "size",
            "executable",
            "method"
          ],
          "properties": {
            "va": {
              "type": "integer",
              "minimum": 0
            },
            "size": {
              "type": "integer",
              "minimum": 1
            },
            "executable": {
              "type": "boolean"
            },
            "method": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "associated_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "offset",
              "size",
              "section",
              "authorization_ref"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "rodata_message",
                  "header_update",
                  "relocation"
                ]
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "size": {
                "type": "integer",
                "minimum": 1
              },
              "section": {
                "type": "string",
                "minLength": 1
              },
              "authorization_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "abi_blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "function",
              "va",
              "size",
              "arch"
            ],
            "properties": {
              "function": {
                "type": "string",
                "minLength": 1
              },
              "va": {
                "type": "integer",
                "minimum": 0
              },
              "size": {
                "type": "integer",
                "minimum": 1
              },
              "arch": {
                "type": "string",
                "enum": [
                  "x86_64",
                  "i386",
                  "arm64"
                ]
              },
              "abi_id": {
                "type": "string"
              },
              "evidence_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
