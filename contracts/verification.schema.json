{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binaryrepair.local/contracts/verification.schema.json",
  "title": "Independent verification report",
  "description": "One independent verification report: target identity, generator and verifier identities, an explicit independence statement that excludes generator evidence, required checks, a fail-closed decision, evidence and limitations, and a stable report sha256. decision=verified is only legal when independence.ok and independence.generator_evidence_excluded are true, at least one independent oracle check passed, and no required check failed or was not run; the checker enforces these cross-field rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target",
    "generator",
    "verifier",
    "independence",
    "checks",
    "decision",
    "evidence",
    "limitations",
    "report_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "arch",
        "bits",
        "endian",
        "target_scope"
      ],
      "properties": {
        "target_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "format": {
          "type": "string",
          "enum": [
            "elf",
            "macho",
            "pe"
          ]
        },
        "arch": {
          "type": "string",
          "enum": [
            "x86_64",
            "i386",
            "arm64"
          ]
        },
        "bits": {
          "type": "integer",
          "enum": [
            32,
            64
          ]
        },
        "endian": {
          "type": "string",
          "enum": [
            "little",
            "big"
          ]
        },
        "container": {
          "type": "string"
        },
        "target_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy"
          ],
          "properties": {
            "policy": {
              "type": "string",
              "enum": [
                "target_scoped",
                "whole_image",
                "analysis_only"
              ]
            },
            "name": {
              "type": "string"
            },
            "va": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator_id"
      ],
      "properties": {
        "generator_id": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier_id"
      ],
      "properties": {
        "verifier_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        }
      }
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "generator_evidence_excluded"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "generator_evidence_excluded": {
          "type": "boolean"
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "required",
          "detail"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{1,64}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "independent": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "verified",
        "rejected",
        "inconclusive",
        "not_run"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
