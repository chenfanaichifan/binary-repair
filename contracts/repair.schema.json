{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binaryrepair.local/contracts/repair.schema.json",
  "title": "Repair attempt state record",
  "description": "One canonical repair attempt record: target identity, current and previous state of the single-source state machine, transition reason, evidence and independence gates, candidate hash, release eligibility and evidence refs. release_eligible=true requires state=release_eligible and both gates true; verified states require a candidate hash. The checker enforces these cross-field rules in addition to JSON Schema validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repair_id",
    "target",
    "state",
    "previous_state",
    "transition_reason",
    "evidence_ok",
    "independence_ok",
    "candidate_sha256",
    "evidence_refs",
    "release_eligible",
    "owner"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repair_id": {
      "type": "string",
      "pattern": "^repair-[A-Za-z0-9_.-]{3,}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_sha256",
        "tree_sha256",
        "format",
        "arch",
        "scope"
      ],
      "properties": {
        "target_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tree_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "abi": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "vulnerability",
            "function",
            "module",
            "whole_program"
          ]
        },
        "target_symbol": {
          "type": "string"
        }
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "candidate",
        "analysis_only",
        "patch_candidate",
        "verified",
        "release_eligible",
        "not_run",
        "unavailable",
        "unsupported",
        "rejected",
        "inconclusive",
        "regression_failed",
        "identity_mismatch"
      ]
    },
    "previous_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "transition_reason": {
      "type": "string"
    },
    "evidence_ok": {
      "type": "boolean"
    },
    "independence_ok": {
      "type": "boolean"
    },
    "candidate_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "release_eligible": {
      "type": "boolean"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "review_by": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
