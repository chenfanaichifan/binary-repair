{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binaryrepair.local/contracts/capability.schema.json",
  "title": "Capability dimension record (D01-D20)",
  "description": "One first-level capability dimension record of the Phase-7 capability universe: identity, status, ownership, review date, old-11-dimension mapping and machine-readable evidence references. A record is a registry entry, never a verification claim (status never says verified).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "status",
    "owner",
    "review_by",
    "source_registries",
    "old_11dim_mapping",
    "related_non_goal_ids",
    "evidence_refs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^D(0[1-9]|1[0-9]|20)$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "covered",
        "partial",
        "non_goal",
        "unavailable",
        "not_started"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "review_by": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source_registries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "old_11dim_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_dimensions",
        "mapping_strength"
      ],
      "properties": {
        "old_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "container",
              "arch",
              "bits",
              "endian",
              "sink_class",
              "strategy",
              "destination_kind",
              "evidence_profile",
              "runtime_tier",
              "provider",
              "proof_scope"
            ]
          }
        },
        "mapping_strength": {
          "type": "string",
          "enum": [
            "full",
            "partial",
            "none"
          ]
        }
      }
    },
    "related_non_goal_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "fragment",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "fragment": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "code",
              "audit",
              "claims",
              "acceptance",
              "methodology",
              "artifact"
            ]
          }
        }
      }
    },
    "status_reason": {
      "type": "string"
    },
    "universe_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "old_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mapped_cells": {
          "type": "integer",
          "minimum": 0
        },
        "status_counts": {
          "type": "object"
        },
        "old_dimension_values": {
          "type": "object"
        }
      }
    }
  }
}
