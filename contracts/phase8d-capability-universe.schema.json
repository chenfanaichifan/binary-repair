{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binaryrepair.local/contracts/phase8d-capability-universe.schema.json",
  "title": "Phase-8D capability universe registry",
  "description": "A deterministic registry of explicit capability units derived from the declared 20-dimension/240-cell universe, Phase-8C benchmark observations and read-only analysis evidence. States are evidence-bound and the promotion transition is never automatic.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "phase", "generated_at", "baseline",
    "state_machine", "dimensions", "units", "denominators", "coverage",
    "unknown_space", "counts", "provenance", "limitations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "phase8d_capability_universe"},
    "phase": {"const": "8D"},
    "generated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T00:00:00Z$"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "sha256", "phase8c_release_sha", "phase8c_tree_sha"],
      "properties": {
        "artifact": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "phase8c_release_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "phase8c_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "state_machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "initial_state", "transitions", "promotion_requires", "automatic_promotion_allowed", "rules"],
      "properties": {
        "states": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["unknown", "discovered", "analysis_only", "candidate_generated", "independently_verified", "generalized", "promoted", "unsupported", "not_applicable", "not_run", "unmeasurable"]}
        },
        "initial_state": {"const": "unknown"},
        "transitions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unknown", "discovered", "analysis_only", "candidate_generated", "independently_verified", "generalized", "promoted", "unsupported", "not_applicable", "not_run", "unmeasurable"],
          "properties": {
            "unknown": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "discovered": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "analysis_only": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "candidate_generated": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "independently_verified": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "generalized": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "promoted": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "unsupported": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "not_applicable": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "not_run": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "unmeasurable": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "promotion_requires": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from_state", "gate", "evidence"],
          "properties": {
            "from_state": {"const": "generalized"},
            "gate": {"type": "string", "minLength": 1},
            "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "automatic_promotion_allowed": {"const": false},
        "rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "dimensions": {
      "type": "array", "minItems": 20, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "legacy_status", "state", "dependencies", "evidence_refs", "reason"],
        "properties": {
          "id": {"type": "string", "pattern": "^D\\d{2}$"},
          "title": {"type": "string", "minLength": 1},
          "legacy_status": {"enum": ["covered", "partial", "non_goal", "unavailable", "not_started"]},
          "state": {"enum": ["unknown", "discovered", "analysis_only", "candidate_generated", "independently_verified", "generalized", "promoted", "unsupported", "not_applicable", "not_run", "unmeasurable"]},
          "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^D\\d{2}$"}},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "units": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "unit_kind", "dimension_ids", "state", "denominator_class", "represented_cases", "dependencies", "evidence_refs", "reason"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:\\-]{2,120}$"},
          "unit_kind": {"enum": ["dimension", "declared_cell", "public_benchmark_sample", "hidden_benchmark_aggregate", "analysis_prototype"]},
          "dimension_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^D\\d{2}$"}},
          "state": {"enum": ["unknown", "discovered", "analysis_only", "candidate_generated", "independently_verified", "generalized", "promoted", "unsupported", "not_applicable", "not_run", "unmeasurable"]},
          "denominator_class": {"type": "string", "minLength": 1},
          "represented_cases": {"type": "integer", "minimum": 1},
          "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:\\-]{2,120}$"}},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "denominators": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["denominator", "unit_count", "represented_cases", "state_unit_counts", "state_case_counts", "rates", "note"],
        "properties": {
          "denominator": {"type": "integer", "minimum": 0},
          "unit_count": {"type": "integer", "minimum": 0},
          "represented_cases": {"type": "integer", "minimum": 0},
          "state_unit_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
          "state_case_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
          "rates": {"type": "object", "additionalProperties": {"type": ["number", "null"]}},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["declared_universe", "public_runtime_oracle", "hidden_runtime_oracle", "analysis_only", "promotion"],
      "properties": {
        "declared_universe": {"type": "object", "additionalProperties": true},
        "public_runtime_oracle": {"type": "object", "additionalProperties": true},
        "hidden_runtime_oracle": {"type": "object", "additionalProperties": true},
        "analysis_only": {"type": "object", "additionalProperties": true},
        "promotion": {"type": "object", "additionalProperties": true}
      }
    },
    "unknown_space": {
      "type": "object", "additionalProperties": false,
      "required": ["inside_catalog_unknown_units", "outside_catalog_state", "outside_catalog_count", "outside_catalog_measured_fraction", "reason"],
      "properties": {
        "inside_catalog_unknown_units": {"type": "integer", "minimum": 0},
        "outside_catalog_state": {"const": "unmeasurable"},
        "outside_catalog_count": {"type": "null"},
        "outside_catalog_measured_fraction": {"type": "null"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["unit_count", "state_unit_counts", "generalized", "promoted", "dimension_count", "declared_cell_count"],
      "properties": {
        "unit_count": {"type": "integer", "minimum": 1},
        "state_unit_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "generalized": {"type": "integer", "minimum": 0},
        "promoted": {"type": "integer", "minimum": 0},
        "dimension_count": {"const": 20},
        "declared_cell_count": {"const": 240}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["builder", "builder_version", "sources", "generated_at_policy"],
      "properties": {
        "builder": {"type": "string", "minLength": 1},
        "builder_version": {"type": "integer", "minimum": 1},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
        "generated_at_policy": {"type": "string", "minLength": 1}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
