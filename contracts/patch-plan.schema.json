{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binaryrepair.local/contracts/patch-plan.schema.json",
  "title": "Patch plan (layout-aware candidate plan)",
  "description": "One versioned patch plan exchanged by the repair pipeline and the independent verifier: candidate/target digests, strategy, declared scope policy, resolved target scope, ordered operations (in-place writes, insertions/replacements with candidate offsets), optional executable cave, relocations, ABI evidence blocks, oracle metadata and limitations. The plan replays deterministically into the candidate bytes; associated operations (rodata message/header/relocation) must carry an authorization reference. whole_image plans can never be treated as verified by the verification contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "target_sha256",
    "candidate_sha256",
    "strategy",
    "scope_policy",
    "target_scope",
    "operations",
    "cave",
    "relocations",
    "abi_blocks",
    "oracle",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "pattern": "^plan-[A-Za-z0-9][A-Za-z0-9_.:-]{2,80}$"
    },
    "generator_id": {
      "type": "string",
      "minLength": 1
    },
    "original_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^cand-[A-Za-z0-9][A-Za-z0-9_.:-]{2,80}$"
    },
    "target_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "strategy": {
      "type": "string",
      "minLength": 1
    },
    "scope_policy": {
      "type": "string",
      "enum": [
        "target_scoped",
        "target_scoped_associated",
        "whole_image",
        "analysis_only"
      ]
    },
    "target_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "target_scoped",
            "target_scoped_associated",
            "whole_image",
            "analysis_only"
          ]
        },
        "name": {
          "type": "string"
        },
        "va": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "original_offset",
          "size",
          "before_hex",
          "after_hex",
          "reason"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "write",
              "insert",
              "replace"
            ]
          },
          "original_offset": {
            "type": "integer",
            "minimum": 0
          },
          "candidate_offset": {
            "type": [
              "integer",
              "null"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "before_hex": {
            "type": "string",
            "pattern": "^(?:[0-9a-fA-F]{2})*$"
          },
          "after_hex": {
            "type": "string",
            "pattern": "^(?:[0-9a-fA-F]{2})*$"
          },
          "site_va": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "enum": [
              "reviewed_site",
              "guard_cave",
              "rodata_message",
              "header_update",
              "relocation"
            ]
          },
          "authorization_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "cave": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "va",
        "size",
        "executable",
        "method"
      ],
      "properties": {
        "va": {
          "type": "integer",
          "minimum": 0
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "executable": {
          "type": "boolean"
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offset",
          "size",
          "kind"
        ],
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string"
          }
        }
      }
    },
    "abi_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "function",
          "va",
          "size",
          "arch"
        ],
        "properties": {
          "function": {
            "type": "string",
            "minLength": 1
          },
          "va": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "arch": {
            "type": "string",
            "enum": [
              "x86_64",
              "i386",
              "arm64"
            ]
          },
          "abi_id": {
            "type": "string"
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "oracle": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "runner",
        "tier"
      ],
      "properties": {
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "type": "string",
          "enum": [
            "native_run",
            "emulated_run",
            "static_only",
            "unavailable"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "executed",
            "not_run",
            "unavailable"
          ]
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
