{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binaryrepair.local/contracts/hidden-benchmark-commitment.schema.json",
  "title": "Hidden benchmark commitment (opaque, no contents)",
  "description": "One hidden-benchmark commitment published before a campaign: opaque sample ids/hashes only, counts, a domain-separated commitment digest and the public-manifest digest. It never carries paths, bytes, descriptions or per-sample outcomes; hidden contents stay outside the public tree and isolation is operational, not cryptographic.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "benchmark_id",
    "hidden_version",
    "sample_count",
    "runtime_count",
    "analysis_only_count",
    "commitment_sha256",
    "public_manifest_sha256",
    "created_at",
    "samples",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "hidden_benchmark_commitment"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "hidden_version": {
      "type": "string",
      "minLength": 1
    },
    "sample_count": {
      "type": "integer",
      "minimum": 1
    },
    "runtime_count": {
      "type": "integer",
      "minimum": 0
    },
    "analysis_only_count": {
      "type": "integer",
      "minimum": 0
    },
    "commitment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "public_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "opaque_sample_id",
          "opaque_binary_sha256"
        ],
        "properties": {
          "opaque_sample_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "opaque_binary_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
