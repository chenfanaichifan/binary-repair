{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binary-repair.local/contracts/phase8d-experiment-bundle.schema.json",
  "title": "Phase-8D experiment and evidence bundle",
  "description": "Deterministic record of Phase-8D discovery/acceptance/failure-attribution experiments. A completed experiment is not a capability promotion; status records evidence and limitations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "phase", "generated_at", "baseline_sha", "experiments", "summary", "provenance", "limitations"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "phase8d_experiment_bundle"},
    "phase": {"type": "string", "const": "Phase-8D"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "baseline_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "experiments": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["experiment_id", "question", "hypothesis", "method", "status", "evidence", "result", "limitations", "promotion_effect"],
        "properties": {
          "experiment_id": {"type": "string", "pattern": "^EXP-8D-[A-Z0-9-]+$"},
          "question": {"type": "string", "minLength": 10},
          "hypothesis": {"type": "string", "minLength": 10},
          "method": {"type": "string", "minLength": 10},
          "status": {"type": "string", "enum": ["completed", "completed_rejected", "completed_zero_candidates", "completed_candidates_only", "completed_partial", "completed_no_promotion", "completed_open_gaps", "completed_operational_only", "not_run", "inconclusive"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "role"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "role": {"type": "string", "minLength": 3}}}},
          "result": {"type": "string", "minLength": 10},
          "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
          "promotion_effect": {"type": "string", "const": "none"}
        }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["experiment_count", "verified_true_count", "capability_promotion", "false_verified_observed", "not_run_count"],
      "properties": {
        "experiment_count": {"type": "integer", "minimum": 1},
        "verified_true_count": {"type": "integer", "const": 0},
        "capability_promotion": {"type": "boolean", "const": false},
        "false_verified_observed": {"type": "integer", "const": 0},
        "not_run_count": {"type": "integer", "minimum": 0}
      }
    },
    "provenance": {"type": "object", "additionalProperties": true},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
  }
}
