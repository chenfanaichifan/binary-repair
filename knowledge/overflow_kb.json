      "group": "integer",
      "rule": "c.add-overflow",
      "root_cause": "base_len+input_len wraps and passes check",
      "fix": "compare input_len > limit - base_len after base_len bound"
    },
    {
      "cwe": "CWE-193",
      "group": "off_by_one",
      "rule": "c.off-by-one-loop",
      "root_cause": "i <= len writes one byte past buffer[32]",
      "fix": "capacity check and memcpy of len+1"
    },
    {
