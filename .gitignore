# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
pytest-of-*/
pytest-cache-files-*/
pytest_tmp*/
pytest_cache*/

# Local config and secrets (never commit)
.env
.env.*
!.env.example

# Runtime artifacts: job data, pids, browser temp dirs
var/
*.log

# Local scratch (agent work areas, vendored test deps, pip and pytest temp dirs)
_scratch/
pip_tmp/
pip_cache/
pytest_deps/
.write-probe.tmp

# delivery/ is deliberately tracked: it is the shared hand-off directory for
# M4 and M5. Do not re-add a /delivery/ ignore rule here - a bundle that only
# exists in one worktree is not readable by the other members.

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

binaryrepair-synthetic-*/

# Cross-session notes. Never tracked, 60 KB of decision records: `git clean -fdx`
# and `git stash -u` both destroy it, and `git add -A` commits it. M3 lost it once
# to a stash and recovered it from stash@{0}^3 by hash. Ignoring costs nothing
# because nothing here was ever in the index.
.workbuddy/

# Scratch output. dist/ is deliberately NOT here: it carries tracked
# delivery artifacts that M4/M5 read, and ignoring it would hide updates.
worklogs/
.tmp/
.dsh-acl-recovery/

# Canonical V5 replay logs are tracked evidence (four original logs).
!delivery/**/*.log

