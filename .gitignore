# a `git add -A` here would have swept in a 22 MB git bundle under .tmp/ and the
# dozens of zips under dist/. See record 98 Q5.
.tmp/
worklogs/
dist/
.dsh-acl-recovery/

# Local delivery artifacts (git bundles/archives for teammates)
/delivery/

